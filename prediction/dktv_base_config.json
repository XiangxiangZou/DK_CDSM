{
  "schema_version": 1,
  "methods": {
    "baseline": "fixed_dko",
    "accumulative": "dktv_accumulative",
    "window": "otvdkl_window",
    "selective": "otvdkl_selective"
  },
  "state": ["qa", "qb", "dqa", "dqb"],
  "state_dim": 4,
  "input": "applied_torque",
  "input_dim": 2,
  "sample_dt_s": 0.01,
  "lift": ["x", "phi(x)", "1"],
  "lifted_dim": 16,
  "encoder_output_dim": 11,
  "encoder_update": false,
  "model_form": "affine",
  "state_readout": "exact",
  "coordinates": {
    "state": "normalized",
    "input": "normalized_applied_torque",
    "lift_definition": "z = [x_normalized, phi(x_normalized), 1]",
    "readout": "x_normalized = C0 @ z",
    "normalizer_policy": "fixed_and_shared_by_all_methods_and_direct_refit_oracle"
  },
  "ridge_lambda": 0.001,
  "seed": 20260825,
  "disturbance": {
    "type": "sine_joint_torque",
    "amplitude_n_m": [8.0, 6.0],
    "angular_frequency_rad_s": [5.0, 6.5],
    "phase_rad": [0.3, 1.1],
    "stages": [
      {"name": "nominal", "start_fraction": 0.0, "end_fraction": 0.4, "scale": 0.0},
      {"name": "transition", "start_fraction": 0.4, "end_fraction": 0.7, "scale": 0.5},
      {"name": "time_varying", "start_fraction": 0.7, "end_fraction": 1.0, "scale": 1.0}
    ]
  },
  "collection": {
    "xml": "traj_data/assets/multi_joint_cable_driven_space_robot.xml",
    "safe_limit_ratio": 0.75,
    "q_init_ratio": 0.4,
    "dq_init_range": 0.2,
    "kp": [18.0, 16.0],
    "kd": [2.0, 1.8],
    "reference_waypoints": 5,
    "reference_range_ratio": 0.55,
    "guard_kp": 30.0,
    "guard_kd": 3.0,
    "torque_limit_n_m": 35.0,
    "tension_lower_n": 20.0,
    "tension_upper_n": 50000.0
  },
  "quality": {
    "allocation_residual_tolerance_n_m": 0.0001,
    "tension_outlier_n": 50000.0,
    "reject_nonfinite": true,
    "reject_joint_limit": true,
    "reject_saturation": true
  },
  "training": {
    "hidden": [32, 32],
    "activation": "elu",
    "bound_lift": 1.0,
    "window": 20,
    "window_start": 4,
    "batch_size": 128,
    "learning_rate": 0.001,
    "gradient_clip": 5.0,
    "weight_decay": 0.00001,
    "state_loss_weight": 1.0,
    "embedding_loss_weight": 0.1,
    "train_fraction": 0.75
  },
  "evaluation": {
    "rollout_horizons": [10, 20, 50, 100],
    "stage_rollout_horizon": 20,
    "window_stride": 5,
    "degradation_ratio_min": 1.1
  },
  "profiles": {
    "smoke": {
      "trajectory_count": 6,
      "steps": 120,
      "epochs": 3,
      "steps_per_epoch": 8
    },
    "full": {
      "trajectory_count": 20,
      "steps": 240,
      "epochs": 30,
      "steps_per_epoch": 40
    }
  }
}
