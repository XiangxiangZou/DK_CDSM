{
  "model": "DKAC",
  "config": {
    "lift_dim": 64,
    "hidden": [
      128,
      256,
      128
    ],
    "control_hidden": [
      128,
      128
    ],
    "control_dim_hat": 2,
    "activation": "elu",
    "bound_lift": 1.0,
    "identity_control_bias": true,
    "window": 40,
    "window_start": 4,
    "epochs": 120,
    "steps_per_epoch": 150,
    "batch_size": 256,
    "lr": 0.001,
    "grad_clip": 5.0,
    "weight_decay": 1e-05,
    "w_state": 1.0,
    "w_embed": 0.1
  }
}