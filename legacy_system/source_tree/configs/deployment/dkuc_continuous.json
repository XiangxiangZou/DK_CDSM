{
  "_comment": "Continuous-time DKUC training for Yu-Tan-style KILC. This is the repository implementation of the paper's control-ready DKN idea.",
  "train_dataset": "outputs/data/deployment_pipeline/processed/20260609_194913_PDCtrl_widerange_validated_dkac_circle_20260609_filtered/dataset.npz",
  "val_dataset": "",
  "val_ratio": 0.2,
  "dt": 0.01,
  "seed": 50,
  "device": "cpu",
  "out_dir": "outputs/models/deployment_pipeline",
  "tag": "yu_tan_kilc",
  "training": {
    "lift_dim": 64,
